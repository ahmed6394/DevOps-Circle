POSTGRES_DB=devops_circle
POSTGRES_USER=devops_circle
POSTGRES_PASSWORD=devops_circle_dev
DATABASE_URL=postgresql://devops_circle:devops_circle_dev@postgres:5432/devops_circle
JWT_SECRET=change-this-local-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
# Redis queue/cache settings
REDIS_URL=redis://redis:6379/0
POST_CREATE_QUEUE=devops_circle:queue:post-create
ANALYTICS_CACHE_KEY=devops_circle:analytics:metrics
