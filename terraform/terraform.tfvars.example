# AWS region
aws_region = "eu-north-1"

# t3.large = 2 vCPU / 8 GiB RAM. Recommended for Grafana/Prometheus/ArgoCD.
# t3.medium = 2 vCPU / 4 GiB RAM. Minimum for the app only, without monitoring.
instance_type = "t3.large"

# 30 GB encrypted gp3 EBS root volume
root_volume_size_gb = 30
root_volume_type    = "gp3"

# IMPORTANT: Replace with your public IP /32 before running terraform plan.
# Find your IP: curl https://checkip.amazonaws.com
# This placeholder is deliberately invalid so Terraform fails fast instead of
# opening SSH to the whole internet.
allowed_ssh_cidr = "REPLACE_WITH_YOUR_IP/32"

# App HTTP/HTTPS access. Keep 0.0.0.0/0 for public demo, or restrict to your IP.
allowed_http_cidr = "0.0.0.0/0"

# Admin CIDR for optional ports. Recommended: your public IP /32.
allowed_admin_cidr = "REPLACE_WITH_YOUR_IP/32"

# Leave empty so Terraform creates a key pair from public_key_path.
# Set a real AWS key pair name here to use one that already exists.
existing_key_name = ""

# If existing_key_name is empty, Terraform creates an AWS key pair using this public key.
public_key_path = "~/.ssh/devops_circle_ec2.pub"

# Keep these false. Use kubectl port-forward or SSH tunnel for Grafana/ArgoCD/Prometheus.
enable_k3s_api_access          = false
enable_monitoring_admin_ports = false

enable_ssm = true

extra_tags = {
  # Owner is already set to "Mahabub Ahmed" in main.tf; this mirrors it.
  Owner = "Mahabub Ahmed"
}
